pcall(function()
    local Plrs = game:GetService("Players")
    local RS = game:GetService("RunService")
    local LP = Plrs.LocalPlayer
    local protect_gui = protectgui or (gethui and function(g) g.Parent = gethui() end)

    local function rndStr()
        local c = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        local s = ""
        for i = 1, math.random(16, 24) do s = s .. string.sub(c, math.random(1, #c), math.random(1, #c)) end
        return s
    end

    local G = Instance.new("ScreenGui", protect_gui and nil or game:GetService("CoreGui"))
    G.Name, G.ResetOnSpawn = rndStr(), false
    if protect_gui then protect_gui(G) end

    local function mk(cls, p, props)
        local o = Instance.new(cls, p)
        o.Name = rndStr()
        for k, v in pairs(props) do o[k] = v end
        return o
    end

    local function mkLbl(p, sz, pos, txt, szs, col, alg, font)
        return mk("TextLabel", p, {Size = sz, Position = pos, Text = txt, TextSize = szs, TextColor3 = col, Font = font or Enum.Font.GothamBold, BackgroundTransparency = 1, TextXAlignment = alg or Enum.TextXAlignment.Left})
    end

    -- زر فتح القائمة بستايل Rayfield
    local ToggleBtn = mk("TextButton", G, {Size = UDim2.new(0, 42, 0, 42), Position = UDim2.new(0.04, 0, 0.15, 0), BackgroundColor3 = Color3.fromRGB(21, 21, 26), Text = "Z", TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 16, Active = true, Draggable = true, Font = Enum.Font.GothamBold})
    mk("UICorner", ToggleBtn, {CornerRadius = UDim.new(0, 8)})
    mk("UIStroke", ToggleBtn, {Color = Color3.fromRGB(45, 45, 60), Thickness = 2})

    -- النافذة الرئيسية بستايل Rayfield الفخم الأصلي
    local MainWin = mk("Frame", G, {Size = UDim2.new(0, 460, 0, 280), Position = UDim2.new(0.3, 0, 0.3, 0), BackgroundColor3 = Color3.fromRGB(15, 15, 19), BackgroundTransparency = 0.02, Visible = false, Active = true, Draggable = true})
    mk("UICorner", MainWin, {CornerRadius = UDim.new(0, 8)})
    mk("UIStroke", MainWin, {Color = Color3.fromRGB(38, 38, 50), Thickness = 1.5})

    -- شريط العنوان العلوي (TopBar) على طريقة Rayfield
    local TopBar = mk("Frame", MainWin, {Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = Color3.fromRGB(20, 20, 26)})
    mk("UICorner", TopBar, {CornerRadius = UDim.new(0, 8)})
    
    local FixBar = mk("Frame", TopBar, {Size = UDim2.new(1, 0, 0, 8), Position = UDim2.new(0, 0, 1, -8), BackgroundColor3 = Color3.fromRGB(20, 20, 26), ZIndex = TopBar.ZIndex})

    mkLbl(TopBar, UDim2.new(0, 220, 0, 18), UDim2.new(0, 14, 0, 6), "Zen Hub", 13, Color3.fromRGB(255, 255, 255), Enum.TextXAlignment.Left, Enum.Font.GothamBold)
    local devLabel = mkLbl(TopBar, UDim2.new(0, 220, 0, 14), UDim2.new(0, 14, 0, 22), "by clanzenontop", 8, Color3.fromRGB(130, 130, 150), Enum.TextXAlignment.Left, Enum.Font.Gotham)

    -- زر الإغلاق (×) الكلاسيكي
    local CloseBtn = mk("TextButton", TopBar, {Size = UDim2.new(0, 26, 0, 26), Position = UDim2.new(1, -34, 0, 8), BackgroundColor3 = Color3.fromRGB(28, 28, 36), Text = "×", TextColor3 = Color3.fromRGB(180, 180, 180), TextSize = 16, Font = Enum.Font.GothamBold})
    mk("UICorner", CloseBtn, {CornerRadius = UDim.new(0, 6)})
    CloseBtn.MouseButton1Click:Connect(function() MainWin.Visible = false end)

    ToggleBtn.MouseButton1Click:Connect(function() MainWin.Visible = not MainWin.Visible end)

    -- تأثير الألوان المتغيرة (Rainbow) لحقوق المطور
    RS.Heartbeat:Connect(function()
        local hue = (tick() % 3) / 3
        devLabel.TextColor3 = Color3.fromHSV(hue, 1, 1)
    end)
end)
