-- زر تفعيل ميزة التتبع (Character Movement Tracking) بناءً على طلبك
local TrackButton = Instance.new("TextButton")
TrackButton.Size = UDim2.new(0, 300, 0, 50)
TrackButton.Position = UDim2.new(0.5, -150, 0, 70)
TrackButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
TrackButton.Text = "تفعيل تتبع الحركة"
TrackButton.TextColor3 = Color3.fromRGB(255, 255, 255)
TrackButton.TextSize = 16
TrackButton.Font = Enum.Font.SourceSansBold
TrackButton.Parent = MainFrame

local ButtonCorner = Instance.new("UICorner")
ButtonCorner.CornerRadius = UDim.new(0, 8)
ButtonCorner.Parent = TrackButton

-- وظيفة الزر (تتبع الحركة بدلاً من الكاميرا)
local trackingActive = false
TrackButton.MouseButton1Click:Connect(function()
    trackingActive = not trackingActive
    if trackingActive then
        TrackButton.BackgroundColor3 = Color3.fromRGB(0, 255, 127)
        TrackButton.Text = "تم التفعيل: جاري تتبع حركة الشخصية"
        print("ZEN HUB: Character movement tracking enabled by clanzenontop")
    else
        TrackButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        TrackButton.Text = "تفعيل تتبع الحركة"
        print("ZEN HUB: Tracking disabled")
    end
end)

-- زر إغلاق الواجهة
local CloseButton = Instance.new("TextButton")
