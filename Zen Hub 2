        local st = mkLbl(b, UDim2.new(0.25, 0, 1, 0), UDim2.new(0.70, 0, 0, 0), defaultOn and "ON" or "OFF", 10, defaultOn and Color3.fromRGB(0, 255, 140) or Color3.fromRGB(130, 145, 170), Enum.TextXAlignment.Right, Enum.Font.GothamMedium)
        local act = defaultOn or false
        b.MouseButton1Click:Connect(function()
            act = not act
