            local b = mk("TextButton", parent, {Size = UDim2.new(0.94, 0, 0, 72), Position = UDim2.new(0.03, 0, 0, y), BackgroundColor3 = Color3.fromRGB(15, 22, 33), BackgroundTransparency = 0.2, Text = ""})
            mk("UICorner", b, {CornerRadius = UDim.new(0, 10)})
            mk("UIStroke", b, {Color = Color3.fromRGB(30, 45, 65), Thickness = 1})
            
            mkLbl(b, UDim2.new(0.60, 0, 0, 22), UDim2.new(0.04, 0, 0, 6), t, 10, Color3.fromRGB(215, 225, 240), Enum.TextXAlignment.Left, Enum.Font.GothamBold)
            
            local toggleCircle = mk("Frame", b, {Size = UDim2.new(0, 48, 0, 24), Position = UDim2.new(0.80, 0, 0, 8), BackgroundColor3 = defaultOn and Color3.fromRGB(0, 255, 140) or Color3.fromRGB(25, 35, 50)})
            mk("UICorner", toggleCircle, {CornerRadius = UDim.new(1, 0)})
            mk("UIStroke", toggleCircle, {Color = defaultOn and Color3.fromRGB(50, 255, 160) or Color3.fromRGB(45, 60, 80), Thickness = 1.5})

            local knob = mk("Frame", toggleCircle, {Size = UDim2.new(0, 18, 0, 18), Position = defaultOn and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9), BackgroundColor3 = Color3.fromRGB(255, 255, 255)})
            mk("UICorner", knob, {CornerRadius = UDim.new(1, 0)})

            local dLbl = mkLbl(b, UDim2.new(0.92, 0, 0, 34), UDim2.new(0.04, 0, 0, 32), descText .. " (الأمان: ", 8, Color3.fromRGB(160, 175, 200), Enum.TextXAlignment.Left, Enum.Font.Gotham)
            dLbl.TextWrapped = true

            local pLbl = mkLbl(dLbl, UDim2.new(0, 40, 1, 0), UDim2.new(1, 0, 0, 0), pctText, 8, pctColor, Enum.TextXAlignment.Left, Enum.Font.GothamBold)
            
            local act = defaultOn or false
            b.MouseButton1Click:Connect(function()
                act = not act
                toggleCircle.BackgroundColor3 = act and Color3.fromRGB(0, 255, 140) or Color3.fromRGB(25, 35, 50)
                toggleCircle.BorderColor3 = act and Color3.fromRGB(50, 255, 160) or Color3.fromRGB(45, 60, 80)
                knob:TweenPosition(act and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
                cb(act)
            end)
            return b
        end

        mkLbl(CombatPage, UDim2.new(1, -10, 0, 18), UDim2.new(0, 10, 0, 10), "أدوات القتال", 10, Color3.fromRGB(0, 255, 140), Enum.TextXAlignment.Left, Enum.Font.GothamBold)
        O(CombatPage, 35, "المساعدة التلقائية", "وضع مساعدة آمن بسلوك بشري طبيعي", "80%", Color3.fromRGB(0, 255, 140), function(s) au = s AutoPanel.Visible = s if not s then T.Text = "" end end)
        O(CombatPage, 115, "مساعدة التصويب", "قفل سلس على الأهداف مع إعطاء حرية كاملة لتحريك الكاميرا", "95%", Color3.fromRGB(0, 255, 140), function(s) assistEnabled = s end)
        O(CombatPage, 195, "التوجيه التلقائي", "وضع تتبع الهدف المباشر القياسي", "50%", Color3.fromRGB(255, 220, 50), function(s) autoDirectEnabled = s end)
        O(CombatPage, 275, "تسلق سريع", "تسلق السلالم فوراً بنقرة قفزة واحدة", "99%", Color3.fromRGB(0, 255, 140), function(s) stairClimbEnabled = s end)

        mkLbl(SkillsPage, UDim2.new(1, -10, 0, 18), UDim2.new(0, 10, 0, 10), "المهارات المتقدمة", 10, Color3.fromRGB(0, 255, 140), Enum.TextXAlignment.Left, Enum.Font.GothamBold)
        
        local holdSubMenuVisible = false
        local holdMainBtn = O(SkillsPage, 35, "تثبيت", "يثبت الموضع تلقائياً ويستهدف العدو عند توفر فرصة", "92%", Color3.fromRGB(0, 255, 140), function(s) 
            holdSkillEnabled = s 
        end)

        local HoldSubMenu = mk("Frame", SkillsPage, {Size = UDim2.new(0.94, 0, 0, 60), Position = UDim2.new(0.03, 0, 0, 112), BackgroundColor3 = Color3.fromRGB(12, 17, 26), BackgroundTransparency = 0.1, Visible = false})
        mk("UICorner", HoldSubMenu, {CornerRadius = UDim.new(0, 8)})
        mk("UIStroke", HoldSubMenu, {Color = Color3.fromRGB(0, 255, 140), Thickness = 1})
        mkLbl(HoldSubMenu, UDim2.new(0.9, 0, 0, 18), UDim2.new(0.06, 0, 0, 6), "خيارات قائمة زين", 9, Color3.fromRGB(0, 255, 140), Enum.TextXAlignment.Left, Enum.Font.GothamBold)

        local subSpinActive = false
        local SubToggleBtn = mk("TextButton", HoldSubMenu, {Size = UDim2.new(0.88, 0, 0, 26), Position = UDim2.new(0.06, 0, 0, 28), BackgroundColor3 = Color3.fromRGB(18, 25, 38), Text = "دوران واستهداف (إعطاء القنبلة): معطل", TextColor3 = Color3.fromRGB(200, 215, 235), TextSize = 8, Font = Enum.Font.GothamMedium})
        mk("UICorner", SubToggleBtn, {CornerRadius = UDim.new(0, 6)})

        SubToggleBtn.MouseButton1Click:Connect(function()
            subSpinActive = not subSpinActive
            SubToggleBtn.Text = subSpinActive and "دوران واستهداف (إعطاء القنبلة): مفعل" or "دوران واستهداف (إعطاء القنبلة): معطل"
            SubToggleBtn.TextColor3 = subSpinActive and Color3.fromRGB(0, 255, 140) or Color3.fromRGB(200, 215, 235)
        end)

        holdMainBtn.MouseButton1Click:Connect(function()
            holdSubMenuVisible = not holdSubMenuVisible
            HoldSubMenu.Visible = holdSubMenuVisible
            SkillsPage.CanvasSize = holdSubMenuVisible and UDim2.new(0, 0, 0, 340) or UDim2.new(0, 0, 0, 280)
        end)

        mkLbl(QualityPage, UDim2.new(1, -10, 0, 18), UDim2.new(0, 10, 0, 10), "الجودة والأداء", 10, Color3.fromRGB(0, 255, 140), Enum.TextXAlignment.Left, Enum.Font.GothamBold)
        O(QualityPage, 35, "إزالة اللاج", "يزيل اللاج ويحسن الأداء مع الحفاظ على رسومات نظيفة", "90%", Color3.fromRGB(0, 255, 140), function(s)
            if s then
                for _, v in pairs(workspace:GetDescendants()) do
                    if v:IsA("BasePart") and not v:IsDescendantOf(LP.Character) then v.Material = Enum.Material.SmoothPlastic v.CastShadow = false
                    elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") then v:Destroy() end
                end
            end
        end)
        O(QualityPage, 115, "عرض مربع", "يفعل عرض نسبة الابعاد المربعة السينمائية", "90%", Color3.fromRGB(0, 255, 140), function(s) squareViewEnabled = s end)

        mkLbl(InteractPage, UDim2.new(1, -10, 0, 18), UDim2.new(0, 10, 0, 10), "التفاعل والدردشة", 10, Color3.fromRGB(0, 255, 140), Enum.TextXAlignment.Left, Enum.Font.GothamBold)
        O(InteractPage, 35, "ردود محفزة", "يعرض رسائل تحفيزية وداعمة مخصصة عند الأحداث", "95%", Color3.fromRGB(0, 255, 140), function(s) interactiveMsgsEnabled = s end, true)

        local deathCount = 0
        local loseMsgs = {"استمر في التقدم ولاتهتم 💔", "ابقَ مركزاً وحاول مجدداً", "حظ أوفر في المرة القادمة 🥀"}
        local winMsgs = {"عمل رائع، استمر هكذا 🔥", "أنت وحش و بطل 💪", "لعب نظيف وممتاز 😎"}

        local function setupPlayerTracking(player)
            player.CharacterAdded:Connect(function(char)
                local hum = char:WaitForChild("Humanoid", 5)
                if hum then
                    hum.Died:Connect(function()
                        if player == LP and interactiveMsgsEnabled then
                            deathCount = deathCount + 1
                            if deathCount >= 2 then
                                deathCount = 0
                                showNotification(loseMsgs[math.random(1, #loseMsgs)])
                            end
                        end
                    end)
                end
            end)
        end

        for _, p in pairs(Plrs:GetPlayers()) do setupPlayerTracking(p) end
        Plrs.PlayerAdded:Connect(setupPlayerTracking)

        task.spawn(function()
            while task.wait(1) do
                pcall(function()
                    if interactiveMsgsEnabled and LP.Character then
                        local leaderstats = LP:FindFirstChild("leaderstats")
                        local ks = leaderstats and (leaderstats:FindFirstChild("Kills") or leaderstats:FindFirstChild("KO's") or leaderstats:FindFirstChild("Score"))
                        if ks then
                            local currentKills = ks.Value
                            if _G.lastKills and currentKills > _G.lastKills then
                                showNotification(winMsgs[math.random(1, #winMsgs)])
                            end
                            _G.lastKills = currentKills
                        end
                    end
                end)
            end
        end)

        local function isValidEnemy(eHrp, eP)
            if eP == LP then return false end
            if LP.Team and eP.Team and LP.Team == eP.Team then return false end
            local eHum = eP.Character and eP.Character:FindFirstChildOfClass("Humanoid")
            if not eHum or eHum.Health <= 0 then return false end
            if eHrp.Position.X < 20 then return false end
            return true
        end

        local internalRun = false
        ToggleRunBtn.MouseButton1Click:Connect(function()
            internalRun = not internalRun
            runStatusIndicator.Text, runStatusIndicator.TextColor3 = internalRun and "مفعل" or "متوقف", internalRun and Color3.fromRGB(0, 255, 140) or Color3.fromRGB(130, 145, 170)
        end)

        local function HB(c)
            local bp = LP.Backpack
            if c:FindFirstChild("Bomb") or c:FindFirstChild("HasBomb") or (bp and bp:FindFirstChild("Bomb")) then return true end
            for _, t in pairs(c:GetChildren()) do if t:IsA("Tool") and (t.Name:lower():find("bomb") or t.Name:lower():find("blade") or t.Name:lower():find("ball")) then return true end end
            if bp then for _, t in pairs(bp:GetChildren()) do if t:IsA("Tool") and (t.Name:lower():find("bomb") or t.Name:lower():find("blade") or t.Name:lower():find("ball")) then return true end end end
            return false
        end

        RS.Heartbeat:Connect(function()
            pcall(function()
                workspace.CurrentCamera.FieldOfView = squareViewEnabled and 50 or 70
                local c = LP.Character
                local hum = c and c:FindFirstChildOfClass("Humanoid")
                if not c or not hum or hum.Health <= 0 then
                    if au then T.Text = "" end
                    return
                end
                local hrp = c:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                if stairClimbEnabled then
                    if workspace:FindPartOnRay(Ray.new(hrp.Position, hrp.CFrame.LookVector * 2.5), c) and (hrp.Velocity.Magnitude < 5) then 
                        hum.Jump = true 
                    end
                end

                if assistEnabled and HB(c) then
                    local tp, md = nil, math.huge
                    for _, p in pairs(Plrs:GetPlayers()) do
                        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and isValidEnemy(p.Character.HumanoidRootPart, p) then
                            local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < md then md, tp = d, p.Character.HumanoidRootPart.Position end
                        end
                    end
                    if tp and md <= 20 then
                        local cam = workspace.CurrentCamera
                        local targetCF = CFrame.new(cam.CFrame.Position, Vector3.new(tp.X, hrp.Position.Y, tp.Z))
                        cam.CFrame = cam.CFrame:Lerp(targetCF, 0.04)
                    end
                end

                if holdSkillEnabled and HB(c) then
                    local tp, md, cE = nil, math.huge, nil
                    for _, p in pairs(Plrs:GetPlayers()) do
                        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and isValidEnemy(p.Character.HumanoidRootPart, p) then
                            local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < md then md, tp, cE = d, p.Character.HumanoidRootPart.Position, p.Character.HumanoidRootPart end
                        end
                    end
                    if tp and cE then
                        if subSpinActive then
                            local lookAtPos = Vector3.new(tp.X, hrp.Position.Y, tp.Z)
                            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(hrp.Position, lookAtPos), 0.15)
                        end
                        local dist = (hrp.Position - tp).Magnitude
                        if subSpinActive then
                            local angle = tick() * 4.0
                            local circleOffset = Vector3.new(math.cos(angle) * 3.5, 0, math.sin(angle) * 3.5)
                            hum:MoveTo(tp + circleOffset)
                        else
                            if dist > 3 then hum:MoveTo(tp) end
                        end
                    end
                end

                if autoDirectEnabled and HB(c) then
                    local tp, md = nil, math.huge
                    for _, p in pairs(Plrs:GetPlayers()) do
                        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and isValidEnemy(p.Character.HumanoidRootPart, p) then
                            local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < md then md, tp = d, p.Character.HumanoidRootPart.Position end
                        end
                    end
                    if tp and (hrp.Position - tp).Magnitude > 1.2 then hum:MoveTo(tp) end
                end

                if au then
                    if hrp.Position.X < 20 then T.Text = "" return end
                    if not internalRun then T.Text, T.TextColor3 = "جاهز (متوقف)", Color3.fromRGB(200, 200, 200) return end
                    if hum.MoveDirection.Magnitude > 0.1 then T.Text, T.TextColor3 = "تحكم يدوي", Color3.fromRGB(255, 70, 70) return end
                    if not HB(c) then T.Text, T.TextColor3 = "لا توجد قنبلة", Color3.fromRGB(255, 220, 50) return end

                    T.Text, T.TextColor3 = "السكربت يعمل", Color3.fromRGB(0, 255, 140)
                    local tp, md, cE = nil, math.huge, nil
                    for _, p in pairs(Plrs:GetPlayers()) do
                        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and isValidEnemy(p.Character.HumanoidRootPart, p) then
                            local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < md then md, tp, cE = d, p.Character.HumanoidRootPart.Position, p.Character.HumanoidRootPart end
                        end
                    end

                    if tp and cE then
                        local eHum = cE.Parent:FindFirstChildOfClass("Humanoid")
                        task.wait(math.random(35, 55) / 100)
                        local pred = tp + (eHum and eHum.MoveDirection * 0.7 or Vector3.zero) + Vector3.new(math.random(-6,6),0,math.random(-6,6))*0.1
                        if (hrp.Position - pred).Magnitude <= 3.5 then
                            local tVal = tick() * 2.0
                            hum:MoveTo(pred + Vector3.new(math.cos(tVal)*1.3, 0, math.sin(tVal)*1.3))
                        elseif (hrp.Position - pred).Magnitude > 1.2 then
                            hum:MoveTo(pred)
                        end
                    end
                end
            end)
        end)

        RS.Heartbeat:Connect(function()
            local hue = (tick() % 3) / 3
            local rainbowCol = Color3.fromHSV(hue, 1, 1)
            devNameLabel.TextColor3 = rainbowCol
            infoDevName.TextColor3 = rainbowCol
        end)
    end)
end)
