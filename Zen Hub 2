pcall(function()
    local Plrs = game:GetService("Players")
    local RS = game:GetService("RunService")
    local LP = Plrs.LocalPlayer
    local protect_gui = protectgui or (gethui and function(g) g.Parent = gethui() end)

    local function rndStr()
        local c = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        local s = ""
        for i = 1, math.random(16, 24) do s = s .. string.sub(c, math.random(1, #c), math.random(1, #c)) end
        return s
    end

    local G = Instance.new("ScreenGui", protect_gui and nil or game:GetService("CoreGui"))
    G.Name, G.ResetOnSpawn = rndStr(), false
    if protect_gui then protect_gui(G) end

    local function mk(cls, p, props)
        local o = Instance.new(cls, p)
        o.Name = rndStr()
        for k, v in pairs(props) do o[k] = v end
        return o
    end

    local function mkLbl(p, sz, pos, txt, szs, col, alg, font)
        return mk("TextLabel", p, {Size = sz, Position = pos, Text = txt, TextSize = szs, TextColor3 = col, Font = font or Enum.Font.GothamBold, BackgroundTransparency = 1, TextXAlignment = alg or Enum.TextXAlignment.Left})
    end

    -- زر فتح القائمة بستايل Rayfield الداكن والأنيق
    local ToggleBtn = mk("TextButton", G, {Size = UDim2.new(0, 45, 0, 45), Position = UDim2.new(0.05, 0, 0.15, 0), BackgroundColor3 = Color3.fromRGB(24, 24, 29), Text = "Z", TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 18, Active = true, Draggable = true, Font = Enum.Font.GothamBold})
    mk("UICorner", ToggleBtn, {CornerRadius = UDim.new(0, 10)})
    mk("UIStroke", ToggleBtn, {Color = Color3.fromRGB(50, 50, 65), Thickness = 2})

    -- نافذة السكربت الرئيسية بستايل Rayfield الفخم
    local MainWin = mk("Frame", G, {Size = UDim2.new(0, 450, 0, 300), Position = UDim2.new(0.3, 0, 0.3, 0), BackgroundColor3 = Color3.fromRGB(18, 18, 22), BackgroundTransparency = 0.05, Visible = false, Active = true, Draggable = true})
    mk("UICorner", MainWin, {CornerRadius = UDim.new(0, 10)})
    mk("UIStroke", MainWin, {Color = Color3.fromRGB(45, 45, 60), Thickness = 1.5})

    -- شريط العرض العلوي (TopBar)
    local TopBar = mk("Frame", MainWin, {Size = UDim2.new(1, 0, 0, 45), BackgroundColor3 = Color3.fromRGB(24, 24, 30)})
    mk("UICorner", TopBar, {CornerRadius = UDim.new(0, 10)})
    
    -- إصلاح زوايا الشريط العلوي السفلية لتكون حادة مثل Rayfield
    local FixBar = mk("Frame", TopBar, {Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 1, -10), BackgroundColor3 = Color3.fromRGB(24, 24, 30), ZIndex = TopBar.ZIndex})

    mkLbl(TopBar, UDim2.new(0, 200, 0, 20), UDim2.new(0, 15, 0, 6), "Zen Hub", 14, Color3.fromRGB(255, 255, 255), Enum.TextXAlignment.Left, Enum.Font.GothamBold)
    local devLabel = mkLbl(TopBar, UDim2.new(0, 200, 0, 15), UDim2.new(0, 15, 0, 24), "by clanzenontop", 9, Color3.fromRGB(150, 150, 170), Enum.TextXAlignment.Left, Enum.Font.Gotham)

    -- زر إغلاق النافذة (X)
    local CloseBtn = mk("TextButton", TopBar, {Size = UDim2.new(0, 30, 0, 30), Position = UDim2.new(1, -35, 0, 7.5), BackgroundColor3 = Color3.fromRGB(35, 35, 45), Text = "×", TextColor3 = Color3.fromRGB(200, 200, 200), TextSize = 18, Font = Enum.Font.GothamBold})
    mk("UICorner", CloseBtn, {CornerRadius = UDim.new(0, 6)})
    CloseBtn.MouseButton1Click:Connect(function() MainWin.Visible = false end)

    ToggleBtn.MouseButton1Click:Connect(function() MainWin.Visible = not MainWin.Visible end)

    -- تأثير الألوان المتغيرة (Rainbow) لحقوق المطور
    RS.Heartbeat:Connect(function()
        local hue = (tick() % 3) / 3
        devLabel.TextColor3 = Color3.fromHSV(hue, 1, 1)
    end)
end)
