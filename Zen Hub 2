    local runStatusIndicator = mkLbl(ToggleRunBtn, UDim2.new(0.35, 0, 1, 0), UDim2.new(0.58, 0, 0, 0), "OFF", 9, Color3.fromRGB(130, 145, 170), Enum.TextXAlignment.Right)

    local InnerBox = mk("Frame", AutoPanel, {Size = UDim2.new(0.88, 0, 0, 28), Position = UDim2.new(0.06, 0, 0, 65), BackgroundColor3 = Color3.fromRGB(16, 22, 33), BackgroundTransparency = 0.2})
