pcall(function()
    local Plrs = game:GetService("Players")
    local RS = game:GetService("RunService")
    local LP = Plrs.LocalPlayer
    local protect_gui = protectgui or (gethui and function(g) g.Parent = gethui() end)

    local function rndStr()
        local c = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        local s = ""
        for i = 1, math.random(16, 24) do s = s .. string.sub(c, math.random(1, #c), math.random(1, #c)) end
        return s
    end

    local G = Instance.new("ScreenGui", protect_gui and nil or game:GetService("CoreGui"))
    G.Name, G.ResetOnSpawn = rndStr(), false
    if protect_gui then protect_gui(G) end

    local function mk(cls, p, props)
        local o = Instance.new(cls, p)
        o.Name = rndStr()
        for k, v in pairs(props) do o[k] = v end
        return o
    end

    local function mkLbl(p, sz, pos, txt, szs, col, alg, font)
        return mk("TextLabel", p, {Size = sz, Position = pos, Text = txt, TextSize = szs, TextColor3 = col, Font = font or Enum.Font.GothamBold, BackgroundTransparency = 1, TextXAlignment = alg or Enum.TextXAlignment.Left})
    end

    -- 1. عداد الـ FPS في أعلى اليسار[span_4](start_span)[span_4](end_span)
    local FpsFrame = mk("Frame", G, {Size = UDim2.new(0, 220, 0, 35), Position = UDim2.new(0.02, 0, 0.02, 0), BackgroundColor3 = Color3.fromRGB(30, 20, 15), BackgroundTransparency = 0.4})
    mk("UICorner", FpsFrame, {CornerRadius = UDim.new(0, 6)})
    local FpsLabel = mkLbl(FpsFrame, UDim2.new(1, -10, 1, 0), UDim2.new(0, 8, 0, 0), "FPS: -- | -- msec", 11, Color3.fromRGB(255, 255, 255), Enum.TextXAlignment.Left)

    local lastTick = tick()
    local frameCount = 0
    RS.RenderStepped:Connect(function(dt)
        frameCount = frameCount + 1
        local currentTick = tick()
        if currentTick - lastTick >= 1 then
            local fps = math.floor(frameCount / (currentTick - lastTick))
            local msec = math.round(dt * 1000 * 10) / 10
            FpsLabel.Text = string.format("FPS: %d | %.1f msec", fps, msec)
            frameCount = 0
            lastTick = currentTick
        end
    end)

    -- 2. تحكم الحركة (مربع وغير شفاف تماماً على طراز ماينكرافت في أسفل اليسار)[span_5](start_span)[span_5](end_span)
    local JoyBase = mk("Frame", G, {Size = UDim2.new(0, 110, 0, 110), Position = UDim2.new(0.04, 0, 0.65, 0), BackgroundColor3 = Color3.fromRGB(60, 60, 60), BackgroundTransparency = 0, Active = true, Draggable = true})
    mk("UIStroke", JoyBase, {Color = Color3.fromRGB(120, 120, 120), Thickness = 2})

    local JoyStick = mk("Frame", JoyBase, {Size = UDim2.new(0, 45, 0, 45), Position = UDim2.new(0.5, -22.5, 0.5, -22.5), BackgroundColor3 = Color3.fromRGB(100, 100, 100), BackgroundTransparency = 0})

    -- 3. عداد القنبلة البارز فوق رأس اللاعب[span_6](start_span)[span_6](end_span)
    RS.Heartbeat:Connect(function()
        pcall(function()
            for _, p in pairs(Plrs:GetPlayers()) do
                local char = p.Character
                if char and char:FindFirstChild("Head") and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 then
                    local head = char.Head
                    local hasBomb = false
                    local bombTimeVal = 1

                    if char:FindFirstChild("Bomb") or char:FindFirstChild("HasBomb") then
                        hasBomb = true
                    else
                        for _, item in pairs(char:GetChildren()) do
                            if item:IsA("Tool") and (item.Name:lower():find("bomb") or item.Name:lower():find("ball")) then
                                hasBomb = true
                                break
                            end
                        end
                    end

                    if not hasBomb and p.Backpack then
                        for _, item in pairs(p.Backpack:GetChildren()) do
                            if item:IsA("Tool") and (item.Name:lower():find("bomb") or item.Name:lower():find("ball")) then
                                hasBomb = true
                                break
                            end
                        end
                    end

                    local valObj = char:FindFirstChild("BombTimer") or char:FindFirstChild("Timer")
                    if valObj and (valObj:IsA("NumberValue") or valObj:IsA("IntValue")) then
                        bombTimeVal = math.ceil(valObj.Value)
                    end

                    local billboard = head:FindFirstChild("ZenCustomBillboard")
                    if hasBomb then
                        if not billboard then
                            billboard = Instance.new("BillboardGui", head)
                            billboard.Name = "ZenCustomBillboard"
                            billboard.Size = UDim2.new(0, 100, 0, 60)
                            billboard.StudsOffset = Vector3.new(0, 2.8, 0)
                            billboard.AlwaysOnTop = true

                            local txt = Instance.new("TextLabel", billboard)
                            txt.Name = "BigNum"
                            txt.Size = UDim2.new(1, 0, 1, 0)
                            txt.BackgroundTransparency = 1
                            txt.Font = Enum.Font.GothamBold
                            txt.TextSize = 36
                            txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                            txt.TextStrokeTransparency = 0
                            txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                            txt.TextXAlignment = Enum.TextXAlignment.Center
                            txt.TextYAlignment = Enum.TextYAlignment.Center
                        end
                        local tLabel = billboard:FindFirstChild("BigNum")
                        if tLabel then
                            tLabel.Text = tostring(bombTimeVal)
                        end
                        billboard.Enabled = true
                    else
                        if billboard then
                            billboard.Enabled = false
                        end
                    end
                end
            end
        end)
    end)
end)
