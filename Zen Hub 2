            activeTabIndicator.Position = UDim2.new(0, 0, 0, tabIndex == 1 and 14 or (tabIndex == 2 and 52 or (tabIndex == 3 and 90 or (tabIndex == 4 and 128 or 166))))
        end

        local function setupTabClick(btn, idx)
            btn.MouseButton1Click:Connect(function() switchTab(idx) end)
