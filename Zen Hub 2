                            local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < md then md, tp, cE = d, p.Character.HumanoidRootPart.Position, p.Character.HumanoidRootPart end
                        end
                    end

                    if tp and cE then
                        local eHum = cE.Parent:FindFirstChildOfClass("Humanoid")
                        task.wait(math.random(35, 55) / 100)
                        local pred = tp + (eHum and eHum.MoveDirection * 0.7 or Vector3.zero) + Vector3.new(math.random(-6,6),0,math.random(-6,6))*0.1
                        if (hrp.Position - pred).Magnitude <= 3.5 then
                            local tVal = tick() * 2.0
                            hum:MoveTo(pred + Vector3.new(math.cos(tVal)*1.3, 0, math.sin(tVal)*1.3))
                        elseif (hrp.Position - pred).Magnitude > 1.2 then
                            hum:MoveTo(pred)
                        end
                    end
                end
            end)
        end)

