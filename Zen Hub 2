    mkLbl(Scroll, UDim2.new(1, -10, 0, 16), UDim2.new(0, 10, 0, 5), "الهجوم", 10, Color3.fromRGB(0, 255, 140), Enum.TextXAlignment.Left, Enum.Font.GothamBold)
    O(24, "الأوتو أسيست", 85, function(s) au = s AutoPanel.Visible = s if not s then T.Text = "" end end)
    O(58, "أسست", 90, function(s) assistEnabled = s end)
    O(92, "الاوتو", 50, function(s) autoDirectEnabled = s end)
    O(126, "التسلق (ماب النط)", 98, function(s) stairClimbEnabled = s end)

    mkLbl(Scroll, UDim2.new(1, -10, 0, 16), UDim2.new(0, 10, 0, 164), "الرؤية", 10, Color3.fromRGB(0, 255, 140), Enum.TextXAlignment.Left, Enum.Font.GothamBold)
    O(183, "ازالة اللاج", 99, function(s)
        if s then
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and not v:IsDescendantOf(LP.Character) then v.Material = Enum.Material.SmoothPlastic v.CastShadow = false
                elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") then v:Destroy() end
