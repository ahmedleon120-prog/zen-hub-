    O(274, "الردود التشجيعية", 100, function(s) messagesEnabled = s end, true)

    mkLbl(Scroll, UDim2.new(1, -10, 0, 16), UDim2.new(0, 10, 0, 312), "الحماية", 10, Color3.fromRGB(0, 255, 140), Enum.TextXAlignment.Left, Enum.Font.GothamBold)
    local SecBtn = mk("TextButton", Scroll, {Size = UDim2.new(0.92, 0, 0, 30), Position = UDim2.new(0.04, 0, 0, 331), BackgroundColor3 = Color3.fromRGB(20, 28, 40), BackgroundTransparency = 0.1, Text = ""})
    mk("UICorner", SecBtn, {CornerRadius = UDim.new(0, 6)})
    mkLbl(SecBtn, UDim2.new(1, -10, 1, 0), UDim2.new(0.08, 0, 0, 0), "شرح الحماية", 10, Color3.fromRGB(0, 255, 140), Enum.TextXAlignment.Left, Enum.Font.GothamBold)
    SecBtn.MouseButton1Click:Connect(function() SecurityPanel.Visible = not SecurityPanel.Visible end)

    local deathCount = 0
    local loseMsgs = {"ليه صاير نوب💔", "شد اللعب شويه", "حظ اوفر للمره الجايه🥀"}

    local function setupPlayerTracking(player)
        player.CharacterAdded:Connect(function(char)
            local hum = char:WaitForChild("Humanoid", 5)
            if hum then
                hum.Died:Connect(function()
                    if player == LP then
                        deathCount = deathCount + 1
                        if deathCount >= 2 then
                            deathCount = 0
                            showNotification(loseMsgs[math.random(1, #loseMsgs)], Color3.fromRGB(220, 230, 245), 4)
                        end
                    end
                end)
            end
        end)
    end

    for _, p in pairs(Plrs:GetPlayers()) do setupPlayerTracking(p) end
    Plrs.PlayerAdded:Connect(setupPlayerTracking)

    local function isWallBetween(pos1, pos2)
        local rayParams = RaycastParams.new()
        rayParams.FilterType = RaycastParams.FilterType.Exclude
        rayParams.FilterDescendantsInstances = {LP.Character}
        local result = workspace:Raycast(pos1, (pos2 - pos1), rayParams)
        if result and result.Instance and not result.Instance:IsDescendantOf(Plrs:GetPlayerFromCharacter(result.Instance.Parent) and result.Instance.Parent or workspace) then
            return true
        end
        return false
    end

    local function isValidEnemy(eHrp, eP)
        if eP == LP or (LP.Team and eP.Team and LP.Team == eP.Team) or eHrp.Position.X < 20 then return false end
        local eHum = eP.Character and eP.Character:FindFirstChildOfClass("Humanoid")
        if not eHum or eHum.Health <= 0 then return false end
        return true
    end

    local internalRun = false
    ToggleRunBtn.MouseButton1Click:Connect(function()
        internalRun = not internalRun
        runStatusIndicator.Text, runStatusIndicator.TextColor3 = internalRun and "ON" or "OFF", internalRun and Color3.fromRGB(0, 255, 140) or Color3.fromRGB(130, 145, 170)
    end)

    local function HB(c)
        local bp = LP.Backpack
        if c:FindFirstChild("Bomb") or c:FindFirstChild("HasBomb") or (bp and bp:FindFirstChild("Bomb")) then return true end
        for _, t in pairs(c:GetChildren()) do if t:IsA("Tool") and (t.Name:lower():find("bomb") or t.Name:lower():find("blade") or t.Name:lower():find("ball")) then return true end end
        if bp then for _, t in pairs(bp:GetChildren()) do if t:IsA("Tool") and (t.Name:lower():find("bomb") or t.Name:lower():find("blade") or t.Name:lower():find("ball")) then return true end end end
        return false
    end

    RS.Heartbeat:Connect(function()
        pcall(function()
            workspace.CurrentCamera.FieldOfView = squareViewEnabled and 50 or 70

            local c = LP.Character
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            
            if not c or not hum or hum.Health <= 0 then
                if au then T.Text = "" end
                return
            end

            local hrp = c:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            if stairClimbEnabled then
                if workspace:FindPartOnRay(Ray.new(hrp.Position, hrp.CFrame.LookVector * 2.5), c) and (hrp.Velocity.Magnitude < 5) then 
                    hum.Jump = true 
                end
            end

            if assistEnabled and HB(c) then
                local tp, md = nil, math.huge
                for _, p in pairs(Plrs:GetPlayers()) do
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and isValidEnemy(p.Character.HumanoidRootPart, p) then
                        local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                        if d < md and not isWallBetween(hrp.Position, p.Character.HumanoidRootPart.Position) then 
                            md, tp = d, p.Character.HumanoidRootPart.Position 
                        end
                    end
                end
                if tp and md <= 9.5 then
                    local cam = workspace.CurrentCamera
                    cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, Vector3.new(tp.X, hrp.Position.Y, tp.Z)), 0.3)
                end
            end

            if autoDirectEnabled and HB(c) then
                local tp, md = nil, math.huge
                for _, p in pairs(Plrs:GetPlayers()) do
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and isValidEnemy(p.Character.HumanoidRootPart, p) then
                        local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                        if d < md and not isWallBetween(hrp.Position, p.Character.HumanoidRootPart.Position) then 
                            md, tp = d, p.Character.HumanoidRootPart.Position 
                        end
                    end
                end
                if tp and (hrp.Position - tp).Magnitude > 1.2 then hum:MoveTo(tp) end
            end

            if au then
                if hrp.Position.X < 20 then T.Text = "" return end
                if not internalRun then T.Text, T.TextColor3 = "جاهز (متوقف)", Color3.fromRGB(200, 200, 200) return end
                if hum.MoveDirection.Magnitude > 0.1 then T.Text, T.TextColor3 = "التحكم صار لك", Color3.fromRGB(255, 70, 70) return end
                if not HB(c) then T.Text, T.TextColor3 = "مو معاك قنبله", Color3.fromRGB(255, 220, 50) return end

                T.Text, T.TextColor3 = "السكربت يشتغل", Color3.fromRGB(0, 255, 140)
                local tp, md, cE = nil, math.huge, nil
                for _, p in pairs(Plrs:GetPlayers()) do
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and isValidEnemy(p.Character.HumanoidRootPart, p) then
                        local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                        if d < md and not isWallBetween(hrp.Position, p.Character.HumanoidRootPart.Position) then 
                            md, tp, cE = d, p.Character.HumanoidRootPart.Position, p.Character.HumanoidRootPart 
                        end
                    end
                end

                if tp and cE then
                    local eHum = cE.Parent:FindFirstChildOfClass("Humanoid")
                    local pred = tp + (eHum and eHum.MoveDirection * 0.9 or Vector3.zero) + Vector3.new(math.random(-8,8),0,math.random(-8,8))*0.1
                    if (hrp.Position - pred).Magnitude <= 3.5 then
                        local tVal = tick() * 2.0
                        hum:MoveTo(pred + Vector3.new(math.cos(tVal)*1.3, 0, math.sin(tVal)*1.3))
                    elseif (hrp.Position - pred).Magnitude > 1.2 then
                        hum:MoveTo(pred)
                    end
                end
            end
        end)
    end)
end)
